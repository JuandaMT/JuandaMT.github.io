---
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, locales, defaultLang, localizePath, useTranslations } from '../i18n/utils';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
  /** Locale-independent path of this page, e.g. '/' or '/projects/agency-console/'. */
  path: string;
  title?: string;
  description?: string;
  /** Path under /public of the Open Graph image. */
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { lang, path, title, description, ogImage, type = 'website', noindex = false } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL('https://juandamt.github.io');

const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${t.meta.role}`;
const desc = description ?? t.meta.description;
const canonical = new URL(localizePath(path, lang), site).href;
const alternates = locales.map((l) => ({
  lang: l,
  href: new URL(localizePath(path, l), site).href,
}));
const xDefault = new URL(localizePath(path, defaultLang), site).href;
const og = new URL(ogImage ?? `/og/home-${lang}.png`, site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: t.meta.role,
  url: new URL(localizePath('/', lang), site).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: profile.locality,
    addressCountry: profile.country,
  },
  sameAs: [profile.links.linkedin, profile.links.github],
  knowsLanguage: ['es', 'en'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.lang} href={a.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:locale:alternate" content={lang === 'en' ? 'es_ES' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#f6f3ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1117" media="(prefers-color-scheme: dark)" />

    <!-- Set the theme before first paint to avoid a flash. -->
    <script is:inline>
      (() => {
        let stored;
        try {
          stored = localStorage.getItem('theme');
        } catch {
          stored = null;
        }
        const dark = stored
          ? stored === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.add(dark ? 'dark' : 'light');
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="skip-link">
      {t.a11y.skip}
    </a>
    <Header lang={lang} path={path} />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
