---
import '@fontsource-variable/geist';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/lab.css';
import SeoHead from '../components/SeoHead.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { type Lang, localizePath, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  steps: number;
}
const { lang, steps } = Astro.props;
const t = useTranslations(lang);
const path = '/lab/';
---

<!doctype html>
<html lang={lang} class="dark lab">
  <head>
    <SeoHead
      lang={lang}
      path={path}
      title={t.lab.title}
      description={t.lab.description}
      themeColor={{ light: '#07080b', dark: '#07080b' }}
    />
  </head>
  <body class="min-h-dvh text-ink">
    <canvas class="lab-scene" data-scene data-steps={steps} aria-hidden="true"></canvas>
    <div class="lab-grain" aria-hidden="true"></div>
    <a href="#main" class="skip-link">
      {t.a11y.skip}
    </a>

    <header class="fixed inset-x-0 top-0 z-40 mix-blend-difference">
      <div class="flex h-16 items-center justify-between px-4 sm:px-8">
        <a href={localizePath(path, lang)} class="font-medium tracking-tight">
          JDM
          <span class="text-accent" aria-hidden="true">
            .
          </span>
          <span class="sr-only"> · Juan David Mayorga</span>
        </a>
        <div class="flex items-center gap-2 sm:gap-4">
          <a
            href={localizePath('/', lang)}
            class="font-mono text-xs text-muted transition-colors hover:text-ink"
            data-classic-link
          >
            {t.lab.classic}
          </a>
          <LangSwitch lang={lang} path={path} />
        </div>
      </div>
    </header>

    <main id="main" class="lab-content" tabindex="-1">
      <slot />
    </main>

    <script>
      import '../scripts/lab/main';
    </script>
  </body>
</html>
