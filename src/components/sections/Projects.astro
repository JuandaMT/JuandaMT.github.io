---
import SectionHeading from '../SectionHeading.astro';
import ProjectCard from '../ProjectCard.astro';
import Chips from '../Chips.astro';
import Todo from '../Todo.astro';
import { type Lang, localizePath, useTranslations } from '../../i18n/utils';
import { getProjects } from '../../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = useTranslations(lang);
const t = ui.projects;
const all = await getProjects(lang);
const main = all.filter((p) => p.data.tier === 'main');
const lab = all.filter((p) => p.data.tier === 'lab');
---

<section id="projects" aria-labelledby="projects-title" class="border-t border-line py-20 sm:py-28">
  <div class="container-page">
    <SectionHeading id="projects" label={t.label} title={t.title} />
    <p class="-mt-4 mb-10 max-w-2xl text-muted">{t.intro}</p>

    <div class="grid gap-5 md:grid-cols-2">
      {main.map((project, i) => (
        <ProjectCard project={project} index={i} lang={lang} />
      ))}
    </div>

    {lab.length > 0 && (
      <div class="mt-16">
        <h3 class="font-mono text-xs tracking-wide text-accent">{t.labTitle}</h3>
        <p class="mt-2 text-sm text-muted">{t.labIntro}</p>
        <a
          href={localizePath('/lab/', lang)}
          class="group mt-6 flex items-center justify-between gap-4 rounded-2xl border border-line bg-surface p-6 transition-colors hover:border-accent/60"
          data-lab-link
        >
          <span>
            <span class="block font-semibold tracking-tight">{ui.lab.interactive}</span>
            <span class="mt-1 block text-sm text-muted">{ui.lab.interactiveCta}</span>
          </span>
          <span
            aria-hidden="true"
            class="text-accent transition-transform group-hover:translate-x-1"
          >
            →
          </span>
        </a>
        <div class="mt-6 grid gap-5 md:grid-cols-2">
          {lab.map(({ data }) => (
            <article class="reveal rounded-2xl border border-dashed border-line p-6">
              <h4 class="font-semibold tracking-tight">{data.title}</h4>
              <p class="mt-1.5 text-sm text-muted">{data.tagline}</p>
              {data.contribution.length > 0 && (
                <ul class="mt-4 space-y-1.5 text-sm">
                  {data.contribution.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              )}
              {data.todos.map((note) => (
                <div class="mt-3">
                  <Todo note={note} />
                </div>
              ))}
              <Chips items={data.stack} label={t.stack} class="mt-5" />
            </article>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
