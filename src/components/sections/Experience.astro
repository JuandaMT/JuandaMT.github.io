---
import SectionHeading from '../SectionHeading.astro';
import Chips from '../Chips.astro';
import Todo from '../Todo.astro';
import { type Lang, useTranslations } from '../../i18n/utils';
import { getExperience } from '../../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang).experience;
const items = await getExperience(lang);
---

<section
  id="experience"
  aria-labelledby="experience-title"
  class="border-t border-line py-20 sm:py-28"
>
  <div class="container-page">
    <SectionHeading id="experience" label={t.label} title={t.title} />
    <ol class="space-y-16">
      {
        items.map(({ data }) => (
          <li class="reveal grid gap-3 md:grid-cols-[13rem_1fr] md:gap-12">
            <p class="pt-1.5 font-mono text-xs text-muted">
              {data.start} — {data.end ?? t.present}
              {data.location && <span class="block pt-1">{data.location}</span>}
            </p>
            <div>
              <h3 class="text-xl font-semibold tracking-tight">
                {data.role}
                <span class="font-normal text-muted"> · {data.company}</span>
              </h3>
              <p class="mt-1.5 text-muted">{data.context}</p>
              {data.todos.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {data.todos.map((note) => (
                    <Todo note={note} />
                  ))}
                </div>
              )}
              <ul class="mt-6 space-y-3 leading-relaxed">
                {data.highlights.map((h) => (
                  <li class="relative pl-5 text-pretty before:absolute before:top-[0.8em] before:left-0 before:h-px before:w-2.5 before:bg-accent">
                    {h}
                  </li>
                ))}
              </ul>
              <Chips items={data.stack} label={t.stack} class="mt-6" />
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
