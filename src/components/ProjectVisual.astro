---
/**
 * One line drawing per project: the thing that makes it recognisable at a glance.
 * Pure inline SVG, themed through CSS variables (.pv in global.css), so it works in
 * the classic site and in /lab/. Decorative: the project title carries the meaning.
 */
export type VisualKind =
  | 'access'
  | 'coaching'
  | 'store'
  | 'fitness'
  | 'notebook'
  | 'garage'
  | 'roulette'
  | 'building'
  | 'crm';

interface Props {
  kind?: VisualKind;
  class?: string;
}
const { kind, class: className } = Astro.props;
---

{kind && (
  <svg
    class:list={['pv', `pv-${kind}`, className]}
    viewBox="0 0 320 200"
    aria-hidden="true"
    focusable="false"
  >
    {kind === 'access' && (
      <>
        <circle cx="38" cy="82" r="13" />
        <path d="M14 130c2-20 13-27 24-27s22 7 24 27" />
        <path class="a flow dash" d="M66 100C140 100 150 38 216 38" />
        <path class="a flow dash" d="M66 100H216" />
        <path class="dim dash" d="M66 100C140 100 150 162 216 162" />
        <rect class="a soft" x="218" y="22" width="86" height="32" rx="4" />
        <path class="a" d="M230 34h34M230 43h20" />
        <rect class="a soft" x="218" y="84" width="86" height="32" rx="4" />
        <path class="a" d="M230 96h34M230 105h20" />
        <rect class="dim dash" x="218" y="146" width="86" height="32" rx="4" />
        <path class="dim" d="M230 158h34M230 167h20" />
        <rect class="bgf" x="124" y="88" width="26" height="20" rx="3" />
        <path d="M130 88v-6a7 7 0 0 1 14 0v6" />
        <circle class="af" cx="137" cy="98" r="2.5" />
        <path class="dim" d="M166 150l10 10M176 150l-10 10" />
      </>
    )}
    {kind === 'coaching' && (
      <>
        <rect x="34" y="14" width="252" height="172" rx="8" class="bgf" />
        <path class="dim" d="M34 40h252" />
        <circle class="a" cx="50" cy="27" r="4" />
        <path class="dim" d="M62 27h50" />
        {[0, 1, 2].flatMap((r) =>
          [0, 1, 2, 3, 4, 5, 6].map((c) => {
            const done = r * 7 + c < 12;
            return (
              <rect
                class:list={[done ? 'a soft' : 'dim']}
                x={52 + c * 31}
                y={52 + r * 21}
                width="19"
                height="13"
                rx="3"
              />
            );
          }),
        )}
        <path class="a" d="M56 164l44-10 38 4 46-22 40 6 52-30" />
        <circle class="af" cx="276" cy="112" r="4" />
        <path class="dim" d="M52 172h232" />
      </>
    )}
    {kind === 'store' && (
      <>
        <rect x="30" y="14" width="124" height="74" rx="6" class="bgf" />
        <path class="dim" d="M30 30h124" />
        <path class="a" d="M52 70l4-22h26l5 22zM60 48l4-8h12l4 8" />
        <circle class="a" cx="62" cy="76" r="2.5" />
        <circle class="a" cx="80" cy="76" r="2.5" />
        <rect x="166" y="14" width="124" height="74" rx="6" class="bgf" />
        <path class="dim" d="M166 30h124M182 46h50M182 58h72M182 70h36" />
        <rect class="a soft" x="30" y="108" width="260" height="78" rx="6" />
        <path class="a" d="M30 126h260" />
        {[0, 1, 2, 3].map((i) => (
          <rect class="bgf" x={48 + i * 62} y="138" width="46" height="34" rx="4" />
        ))}
        <path class="a flow dash" d="M92 88v20M228 88v20" />
        <path class="dim" d="M46 117h22" />
      </>
    )}
    {kind === 'fitness' && (
      <>
        <circle class="dim" cx="104" cy="100" r="56" />
        <circle
          class="a ring"
          cx="104"
          cy="100"
          r="56"
          pathLength="100"
          transform="rotate(-90 104 100)"
        />
        <path class="a" d="M70 100h22l8-22 12 46 10-30 6 6h22" />
        <path d="M196 100h96" />
        <rect class="a soft" x="200" y="68" width="12" height="64" rx="3" />
        <rect class="a soft" x="216" y="78" width="10" height="44" rx="3" />
        <rect class="a soft" x="278" y="68" width="12" height="64" rx="3" />
        <rect class="a soft" x="264" y="78" width="10" height="44" rx="3" />
        <path class="dim" d="M198 150h96M198 164h60" />
      </>
    )}
    {kind === 'notebook' && (
      <>
        <rect x="30" y="22" width="124" height="156" rx="6" class="bgf" />
        <rect x="166" y="22" width="124" height="156" rx="6" class="bgf" />
        <path
          class="dim"
          d="M46 44h50M54 58h70M54 72h44M46 86h62M54 100h78M54 114h36M46 128h54M54 142h66"
        />
        <path class="a" d="M54 58h26M54 100h30" />
        <path class="a" d="M184 58l16 12-16 12" />
        <rect class="af cursor" x="208" y="78" width="12" height="5" />
        <path class="dim" d="M184 112h86M184 126h62M184 140h74M184 154h40" />
        <path class="a" d="M160 22v156" />
      </>
    )}
    {kind === 'garage' && (
      <>
        <path class="a flow dash" d="M26 76Q160 -4 294 76" />
        <circle class="af" cx="294" cy="76" r="4" />
        <path class="dim" d="M20 158h280" />
        <path
          class="bgf"
          d="M34 134c0-14 12-20 34-24l42-22c18-10 64-12 92 0l36 20c22 4 44 12 46 28z"
        />
        <path d="M120 100l26-14h42l28 18z" />
        <path class="a" d="M268 118c8 1 14 4 16 8" />
        <g class="spin">
          <circle class="bgf" cx="86" cy="138" r="20" />
          <path d="M86 118v40M66 138h40M72 124l28 28M100 124l-28 28" />
        </g>
        <g class="spin">
          <circle class="bgf" cx="244" cy="138" r="20" />
          <path d="M244 118v40M224 138h40M230 124l28 28M258 124l-28 28" />
        </g>
        <path class="dim" d="M62 176h196" />
      </>
    )}
    {kind === 'roulette' && (
      <>
        <g class="spin slow">
          <circle cx="160" cy="104" r="72" class="bgf" />
          <path class="a soft" d="M160 104L232 104A72 72 0 0 1 211 155Z" />
          <path class="a soft" d="M160 104L160 176A72 72 0 0 1 109 155Z" />
          <path class="a soft" d="M160 104L88 104A72 72 0 0 1 109 53Z" />
          <path class="a soft" d="M160 104L160 32A72 72 0 0 1 211 53Z" />
          <path class="dim" d="M160 104L211 155M160 104L109 155M160 104L109 53M160 104L211 53" />
          <circle class="bgf" cx="160" cy="104" r="16" />
          <path class="af" d="M155 96l13 8-13 8z" />
        </g>
        <path class="af" d="M160 36l-10-20h20z" />
        <path class="dim" d="M44 52h30M36 70h22M262 140h26M268 158h20" />
      </>
    )}
    {kind === 'building' && (
      <>
        <path class="dim" d="M20 176h280" />
        <rect x="104" y="22" width="112" height="154" class="bgf" />
        <path d="M96 22h128" />
        {[0, 1, 2, 3].flatMap((r) =>
          [0, 1, 2].map((c) => {
            const lit = (r * 3 + c) % 4 === 1;
            return (
              <rect
                class:list={[lit ? 'a soft lit' : 'dim']}
                x={116 + c * 32}
                y={36 + r * 28}
                width="22"
                height="16"
              />
            );
          }),
        )}
        <rect x="148" y="146" width="24" height="30" />
        <path class="a flow dash" d="M28 176C56 176 68 138 92 126S96 74 112 66 124 44 160 40" />
        <circle class="af" cx="160" cy="40" r="4" />
        <rect class="dim" x="240" y="112" width="62" height="56" />
        <path class="dim" d="M240 138h30M270 112v26M270 150h32M256 138v30" />
        <path class="a" d="M246 124h8" />
      </>
    )}
    {kind === 'crm' && (
      <>
        <path class="bgf" d="M40 22h240l-30 40H70z" />
        <path class="bgf" d="M76 70h168l-24 38H100z" />
        <path class="bgf a" d="M112 116h96l-14 36h-68z" />
        <path class="dim" d="M70 42h180M108 88h104" />
        <circle class="af drop" cx="130" cy="38" r="4" />
        <circle class="af drop d2" cx="160" cy="38" r="4" />
        <circle class="af drop d3" cx="190" cy="38" r="4" />
        <path class="a" d="M160 152v14" />
        <circle class="a soft" cx="160" cy="180" r="12" />
        <path class="a" d="M154 180l5 5 8-10" />
        <path class="a" d="M296 62c-9-12-14-17-14-24a14 14 0 0 1 28 0c0 7-5 12-14 24z" />
        <circle class="af" cx="296" cy="38" r="4" />
      </>
    )}
  </svg>
)}
