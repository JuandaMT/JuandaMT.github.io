---
/**
 * Interactive portfolio, drawn as a set of technical sheets ("Plano de obra").
 * All copy comes from i18n and content collections; motion lives in scripts/lab.
 */
import Lab from '../../layouts/Lab.astro';
import ExtLink from '../ExtLink.astro';
import ProjectVisual from '../ProjectVisual.astro';
import { type Lang, localizePath, useTranslations } from '../../i18n/utils';
import { getExperience, getProjects, publicFileExists, slugOf } from '../../lib/content';
import { profile } from '../../data/profile';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = useTranslations(lang);
const t = ui.lab;
const steps = ui.ai.steps;
const projects = (await getProjects(lang)).filter((p) => p.data.tier === 'main');
const experience = await getExperience(lang);
const cvs = [
  { label: ui.contact.cvEn, href: profile.cv.en, lang: 'en' },
  { label: ui.contact.cvEs, href: profile.cv.es, lang: 'es' },
].filter((c) => publicFileExists(c.href));
const [first, ...rest] = profile.name.split(' ');
const nameLines = [`${first} ${rest[0] ?? ''}`.trim(), rest.slice(1).join(' ')].filter(Boolean);

// Sheet numbering: hero, loop, one per project, experience, materials, handover.
const total = 2 + projects.length + 3;
const pad = (n: number) => String(n).padStart(2, '0');
const sheetOf = (n: number) => `${pad(n)} / ${pad(total)}`;
const expSheet = 3 + projects.length;
const revision = new Date().toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', {
  day: '2-digit',
  month: '2-digit',
  year: 'numeric',
});
---

<Lab lang={lang}>
  <!-- ============ 01 · Elevation (hero) ============ -->
  <section class="bp-section bp-hero" aria-labelledby="hero-title">
    <div class="bp-hero-copy">
      <p class="bp-eyebrow">
        {t.sheet} 01 — {t.eyebrow}
      </p>
      <h1 id="hero-title" class="bp-display bp-hero-title" aria-label={profile.name}>
        {nameLines.map((line) => (
          <span aria-hidden="true">{line}</span>
        ))}
      </h1>
      <p class="bp-lead">{t.lead}</p>
      <div class="bp-actions">
        <a class="bp-btn bp-btn-primary" href="#work">
          {t.workLabel}
          <span aria-hidden="true">↓</span>
        </a>
        <a class="bp-btn" href="#contact">
          {ui.nav.contact}
        </a>
      </div>
    </div>

    <div
      class="bp-drawing-data"
      hidden
      data-levels={JSON.stringify(t.drawing.levels.map((l) => l.toUpperCase()))}
      data-dimension={t.drawing.dimension.toUpperCase()}
    ></div>

    <div class="bp-titleblock" role="group" aria-label={t.titleBlock.label}>
      <dl class="bp-titleblock-grid">
        <div class="span-2">
          <dt>{t.titleBlock.project}</dt>
          <dd>{t.titleBlock.projectValue}</dd>
        </div>
        <div>
          <dt>{t.titleBlock.drawing}</dt>
          <dd>{t.titleBlock.drawingValue}</dd>
        </div>
        <div class="hide-sm">
          <dt>{t.titleBlock.scale}</dt>
          <dd>1:1</dd>
        </div>
        <div class="span-2">
          <dt>{t.titleBlock.role}</dt>
          <dd>{ui.meta.role}</dd>
        </div>
        <div>
          <dt>{t.titleBlock.sheet}</dt>
          <dd>{sheetOf(1)}</dd>
        </div>
        <div class="hide-sm">
          <dt>{t.titleBlock.revision}</dt>
          <dd>{revision}</dd>
        </div>
      </dl>
      <div class="bp-titleblock-status">
        <p
          class="bp-log"
          aria-hidden="true"
          data-log
          data-agents={t.titleBlock.agents}
          data-strokes={t.titleBlock.strokes}
        >
          {t.titleBlock.strokes} 100%
        </p>
        <p class="bp-stamp" data-stamp>
          {t.titleBlock.stamp}
        </p>
      </div>
    </div>
  </section>

  <!-- ============ 02 · The loop (works schedule, pinned) ============ -->
  <section
    id="flow"
    class="bp-section bp-flow"
    aria-labelledby="flow-title"
    data-flow
    tabindex="-1"
  >
    <div class="bp-head">
      <div>
        <p class="bp-eyebrow">
          {t.sheet} 02 — {t.flowLabel}
        </p>
        <h2 id="flow-title" class="bp-display bp-h2">
          {t.flowTitle}
        </h2>
      </div>
    </div>
    <div class="bp-flow-body">
      <div>
        <div class="bp-flow-progress" aria-hidden="true">
          <span data-flow-counter></span>
          <span class="bp-flow-track">
            <span class="bp-flow-bar"></span>
          </span>
        </div>
        <ol class="bp-steps">
          {steps.map((step, i) => (
            <li data-step>
              <p class="bp-step-meta">
                {pad(i + 1)} · {t.phases[i]} · {step.tag}
              </p>
              <h3 class="bp-display bp-step-title">{step.name}</h3>
              <p class="bp-step-text">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>

      <figure class="bp-schedule" aria-hidden="true">
        <figcaption>{t.scheduleLabel}</figcaption>
        <svg viewBox="0 0 400 260" preserveAspectRatio="xMidYMid meet">
          {[0, 1, 2, 3, 4, 5].map((c) => (
            <line class="bp-sch-grid" x1={110 + c * 56} y1="14" x2={110 + c * 56} y2="250" />
          ))}
          {steps.map((_, i) => {
            const y = 34 + i * 48;
            const x1 = 110 + i * 46;
            const x2 = x1 + 100;
            return (
              <g data-row>
                <text class="bp-sch-label" x="0" y={y + 4}>
                  {pad(i + 1)} {t.phases[i]}
                </text>
                <line class="bp-sch-base" x1={x1} y1={y} x2={x2} y2={y} />
                <line class="bp-sch-bar" x1={x1} y1={y} x2={x2} y2={y} pathLength="1" />
                <circle class="bp-sch-agent" cx={x1} cy={y} r="5" />
                {i < steps.length - 1 && (
                  <path class="bp-sch-link" d={`M${x2} ${y} v14 H${x1 + 46} V${y + 42}`} />
                )}
              </g>
            );
          })}
        </svg>
      </figure>
    </div>
  </section>

  <!-- ============ 03…· Projects (one scene each, pinned: scroll changes project) ============ -->
  <section
    id="work"
    class="bp-section bp-work"
    aria-labelledby="work-title"
    data-work
    tabindex="-1"
  >
    <div class="bp-head">
      <div>
        <p class="bp-eyebrow">
          {t.sheet}
          {pad(3)} — {pad(2 + projects.length)}
        </p>
        <h2 id="work-title" class="bp-display bp-h2">
          {t.workLabel}
        </h2>
      </div>
      <p class="bp-hint">{t.workHint}</p>
    </div>
    <div class="bp-work-progress" aria-hidden="true">
      <span data-work-counter></span>
      <span class="bp-ticks">
        {projects.map(() => (
          <span data-tick />
        ))}
      </span>
    </div>
    <ol class="bp-scenes">
      {projects.map((project, i) => {
        const d = project.data;
        const href = localizePath(`/projects/${slugOf(project)}/`, lang);
        const n = 3 + i;
        return (
          <li class="bp-scene" data-card data-scene>
            <div class="bp-scene-copy">
              <div class="bp-sheet-top">
                <span>L-{pad(n)}</span>
                {d.status && <span class="bp-badge">{ui.projects.status[d.status]}</span>}
              </div>
              <h3 class="bp-display bp-scene-title">{d.title}</h3>
              <p class="bp-sheet-text">{d.tagline}</p>
              {d.contribution.length > 0 && (
                <ul class="bp-scene-list">
                  {d.contribution.slice(0, 3).map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              )}
              <div class="bp-sheet-links">
                {d.detailPage && (
                  <a href={href} class="bp-link">
                    {t.caseStudy}
                    <span aria-hidden="true">→</span>
                  </a>
                )}
                {d.links.repo && (
                  <ExtLink href={d.links.repo} lang={lang} class="bp-link">
                    {ui.projects.repo}
                    <span aria-hidden="true">↗</span>
                  </ExtLink>
                )}
                {d.links.live && (
                  <ExtLink href={d.links.live} lang={lang} class="bp-link">
                    {ui.projects.live}
                    <span aria-hidden="true">↗</span>
                  </ExtLink>
                )}
                {d.linkNote && <span class="bp-note">{d.linkNote}</span>}
              </div>
              <p class="bp-scene-stack">
                <span>{t.materials}</span>
                {d.stack.length > 0 ? d.stack.join(' · ') : '—'}
              </p>
            </div>
            <figure class="bp-scene-fig" aria-hidden="true">
              <figcaption>
                FIG. {pad(n)} · {slugOf(project)} · {sheetOf(n)}
              </figcaption>
              <ProjectVisual kind={d.visual} />
            </figure>
          </li>
        );
      })}
    </ol>
  </section>

  <!-- ============ Experience (dimensioned timeline) ============ -->
  <section id="experience" class="bp-section" aria-labelledby="exp-title">
    <div class="bp-head">
      <div>
        <p class="bp-eyebrow">
          {t.sheet} {pad(expSheet)}
        </p>
        <h2 id="exp-title" class="bp-display bp-h2">
          {t.experienceLabel}
        </h2>
      </div>
    </div>
    <ol class="bp-jobs">
      {experience.map(({ data }) => (
        <li class="bp-job" data-reveal>
          <p class="bp-dim">
            <span class="bp-dim-line" aria-hidden="true" />
            <span class="bp-dim-text">
              {data.start} → {data.end ?? ui.experience.present}
            </span>
            <span class="bp-dim-line" aria-hidden="true" />
          </p>
          <div class="bp-job-head">
            <h3 class="bp-display bp-job-title">
              {data.companyUrl ? (
                <ExtLink href={data.companyUrl} lang={lang} class="bp-link-plain">
                  {data.company}
                </ExtLink>
              ) : (
                data.company
              )}
            </h3>
            <p class="bp-job-role">{data.role}</p>
          </div>
          <p class="bp-job-context">{data.context}</p>
          <ul class="bp-job-list">
            {data.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  <!-- ============ Materials schedule (skills) ============ -->
  <section class="bp-section" aria-labelledby="stack-title">
    <div class="bp-head">
      <div>
        <p class="bp-eyebrow">
          {t.sheet} {pad(expSheet + 1)}
        </p>
        <h2 id="stack-title" class="bp-display bp-h2">
          {t.stackLabel}
        </h2>
      </div>
    </div>
    <dl class="bp-materials">
      {ui.skills.groups.map((g, i) => (
        <div class="bp-material" data-reveal>
          <dt>
            <span class="bp-material-code">M-{pad(i + 1)}</span>
            {g.name}
          </dt>
          <dd>{g.items.join(' · ')}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- ============ Handover (contact) ============ -->
  <section id="contact" class="bp-section bp-contact" aria-labelledby="contact-title">
    <p class="bp-eyebrow">
      {t.sheet} {pad(total)} — {t.contactLabel}
    </p>
    <h2 id="contact-title" class="bp-display bp-contact-title" data-reveal>
      {ui.contact.title}
    </h2>
    <p class="bp-lead" data-reveal>
      {ui.contact.text}
    </p>
    <div class="bp-actions" data-reveal>
      {profile.email && (
        <a href={`mailto:${profile.email}`} class="bp-btn bp-btn-primary">
          {t.contactCta}
          <span aria-hidden="true">↗</span>
        </a>
      )}
      <ExtLink href={profile.links.linkedin} lang={lang} class="bp-btn">
        LinkedIn
      </ExtLink>
      <ExtLink href={profile.links.github} lang={lang} class="bp-btn">
        GitHub
      </ExtLink>
    </div>
    {cvs.length > 0 && (
      <p class="bp-cvs" data-reveal>
        <span>{ui.contact.cvTitle}</span>
        {cvs.map((c) => (
          <a href={c.href} download hreflang={c.lang} class="bp-link">
            {c.label}
          </a>
        ))}
      </p>
    )}
    <footer class="bp-footer">
      <span>
        © {new Date().getFullYear()} {profile.name}
      </span>
      <a href={localizePath('/', lang)} class="bp-link">
        {t.classic} →
      </a>
    </footer>
  </section>
</Lab>
