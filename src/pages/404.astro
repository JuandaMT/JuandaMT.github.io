---
import Base from '../layouts/Base.astro';
import en from '../i18n/en';
import es from '../i18n/es';
---

<Base lang="en" path="/404/" title={en.notFound.title} noindex>
  <section class="container-page py-24 sm:py-32">
    <p class="font-mono text-xs text-accent">404 · exit code 1</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">{en.notFound.title}</h1>
    <p class="mt-4 text-lg text-muted">{en.notFound.text}</p>
    <a href="/" class="link mt-6 inline-block font-medium">
      {en.notFound.back}
    </a>

    <div lang="es" class="mt-14 border-t border-line pt-10">
      <h2 class="text-2xl font-semibold tracking-tight">{es.notFound.title}</h2>
      <p class="mt-3 text-muted">{es.notFound.text}</p>
      <a href="/es/" class="link mt-4 inline-block font-medium">
        {es.notFound.back}
      </a>
    </div>
  </section>
</Base>
