---
import type { GetStaticPaths } from 'astro';
import ProjectDetail from '../../components/pages/ProjectDetail.astro';
import { getProjects, slugOf, type Project } from '../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getProjects('en');
  return projects
    .filter((p) => p.data.detailPage)
    .map((project) => ({ params: { slug: slugOf(project) }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props as { project: Project };
---

<ProjectDetail project={project} lang="en" />
